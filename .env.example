# Personal Teacher Assistant for 10th - environment template.
# Copy to .env and fill in real values. NEVER commit .env.
# When running via docker compose, DATABASE_URL / REDIS_URL / S3_* are overridden
# with container-network addresses in docker-compose.yml.

# --- App ---
# development | test | production
ENVIRONMENT=development
# Test sign-in without Google (local development only; refused in production)
DEV_LOGIN_ENABLED=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]
# comma-separated Google emails granted admin role
ADMIN_EMAILS=

# --- Database / queue ---
DATABASE_URL=postgresql+psycopg://pta:pta@localhost:5432/personal_teacher_assistant
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# --- AI ---
OPENAI_API_KEY=sk-your-openai-key
# any OpenAI chat model your key can access
LLM_MODEL=gpt-5.4-mini
# google | azure | fake (dev/tests)
TTS_PROVIDER=google
TTS_API_KEY=your-tts-api-key
AI_GENERATIONS_PER_USER_PER_DAY=10
AI_QUESTIONS_AUTO_APPROVE=true

# --- Storage (S3-compatible; MinIO locally) ---
S3_BUCKET=pta-media
S3_ENDPOINT_URL=http://localhost:9000
# Host used in signed media URLs (phone/emulator must reach it). Empty = S3_ENDPOINT_URL.
# Android emulator: http://10.0.2.2:9000 · real phone: http://<your-LAN-IP>:9000
S3_PUBLIC_ENDPOINT_URL=
# DEV-ONLY MinIO defaults (local only)
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
SIGNED_URL_EXPIRE_SECONDS=3600

# --- Quiz ---
QUIZ_PASS_PCT=60
QUIZ_QUESTIONS_PER_ATTEMPT=10
QUIZ_ATTEMPT_EXPIRE_MINUTES=60

# --- Clients ---
# Android emulator -> host machine
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
VITE_API_URL=http://localhost:8000
