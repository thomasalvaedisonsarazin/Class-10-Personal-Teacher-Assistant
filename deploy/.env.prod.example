# Copy to deploy/.env.prod ON THE SERVER only (never commit it). Fill every CHANGE_ME.
# Generate random values with:  openssl rand -hex 32

# Web addresses (DNS A records -> the server IP)
API_HOST=api.example.com
ADMIN_HOST=admin.example.com

# Internal services
POSTGRES_PASSWORD=CHANGE_ME

# Auth
SECRET_KEY=CHANGE_ME
ADMIN_EMAILS=you@example.com
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# AI
OPENAI_API_KEY=CHANGE_ME
LLM_MODEL=gpt-5.4-mini
TTS_PROVIDER=google
TTS_API_KEY=CHANGE_ME

# Email (Brevo SMTP)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME@smtp-brevo.com
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM=Personal Teacher Assistant <no-reply@example.com>

# Notifications
PUSH_ENABLED=true
